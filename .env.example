# ---- HTTP ----
PORT=3100

# ---- Database (MariaDB 11.4) ----
DB_HOST=127.0.0.1
# 3307 is the port docker-compose.yml publishes. A system-installed MariaDB normally listens on 3306.
DB_PORT=3307
DB_NAME=ivs
# Runtime account: least privilege (audit_log is SELECT/INSERT only). Created by `npm run migrate`.
DB_USER=ivs_app
DB_PASSWORD=change-me-app
# Host pattern the runtime account is granted from ('%' = any; use 'localhost' when co-located).
DB_APP_HOST=%
# Admin account: used only by migrate, seed and tests. Never by the running service.
# It must log in with a password over TCP. On a packaged MariaDB, root uses the local
# socket instead, so create a separate admin account (see README).
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=change-me-root
DB_POOL_LIMIT=10
DB_ACQUIRE_TIMEOUT_MS=3000
DB_CONNECT_TIMEOUT_MS=3000
# Database used by the test suite (dropped and recreated on every run).
TEST_DB_NAME=ivs_test

# ---- Auth ----
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ISSUER=intake-validation-service
JWT_AUDIENCE=intake-validation-api
JWT_TTL_SECONDS=3600
BCRYPT_COST=12

# ---- Validation engine ----
# Per-rule time budget; a rule that exceeds it returns "unknown", never "pass".
RULE_TIMEOUT_MS=2000
# Time budget for a single regular-expression evaluation (runs in a worker thread).
REGEX_TIMEOUT_MS=250
# Tables/columns that lookup rules may reference, as table.column (comma-separated).
LOOKUP_ALLOWLIST=ref_suppliers.code,ref_cost_centres.code

# ---- API ----
MAX_BODY_BYTES=65536
PAGE_SIZE_DEFAULT=25
PAGE_SIZE_MAX=100
HEALTH_DB_TIMEOUT_MS=2000

# ---- External audit anchor ----
# The newest audit rows of each organisation's chain are anchored outside the
# database: row count + head hash, HMAC-signed with ANCHOR_KEY. Put ANCHOR_DIR on
# storage the database's operators cannot write (relative paths resolve from the
# project root). ANCHOR_KEY: at least 32 characters, never stored in the database.
ANCHOR_DIR=var/audit-anchors
ANCHOR_KEY=replace-with-a-different-long-random-secret-32+

# ---- Seed ----
# Password given to every synthetic seed user.
SEED_USER_PASSWORD=Synthetic-Pass-2026!
