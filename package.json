{
  "name": "intake-validation-service",
  "version": "1.0.0",
  "private": true,
  "description": "Intake Validation Service: validates submitted records against database-defined rules and keeps a tamper-evident audit trail.",
  "license": "UNLICENSED",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12.0 <21"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "verify": "node scripts/verify.js",
    "audit:verify": "node scripts/audit-verify.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mariadb": "3.5.4"
  }
}
